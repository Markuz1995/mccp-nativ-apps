# ─── Docker Compose ───────────────────────────────────────────────────────────
DB_DATABASE=mccp_db
DB_USERNAME=mccp_user
DB_PASSWORD=mccp_password

# ─── Gemini ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.0-flash

# ─── Slack / Webhook ──────────────────────────────────────────────────────────
SLACK_WEBHOOK_URL=https://webhook.site/your-unique-id-here

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost/api
